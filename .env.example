# ============================================================================
# qcn-mcp-bridge 配置示例
# ----------------------------------------------------------------------------
# 复制为 .env 并按需修改。.env 已加入 .gitignore，凭证不会进入仓库。
# 任何密钥相关字段遵循 CLAUDE.md §6: 不在代码 / 日志 / 文档中回显明文。
# ============================================================================

# ---- 上游 qcn-dev 服务地址 ------------------------------------------------
# 默认 dev profile 起在本机 8080; 走内网时换成实际入口
QCN_BASE_URL=http://localhost:8080

# ---- service-account JWT --------------------------------------------------
# qcn-dev 鉴权: AuthorizationInterceptor 读 `Authorization: Bearer <token>`
#  (SysConstant.AUTH_NAME=Authorization, AUTH_TYPE_C="Bearer ")
# 用平台内部账号生成的 JWT; 多个可轮换时按 Bearer 列表配置
QCN_JWT=<REDACTED_PLEASE_FILL_SERVICE_ACCOUNT_JWT>

# ---- HTTP 客户端调优 ------------------------------------------------------
# qcn-dev 单次接口响应通常 < 2s, 给 30s 兜底
QCN_HTTP_TIMEOUT=30.0

# ---- MCP server transport -------------------------------------------------
# stdio       — 本地进程直连, WorkBuddy 用 stdio 启动本进程
# streamable-http — WorkBuddy 通过 HTTP 调用 Bridge, 适合远端部署
MCP_TRANSPORT=stdio

# streamable-http 监听参数 (MCP_TRANSPORT=streamable-http 时生效)
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
MCP_HTTP_PATH=/mcp

# ---- 日志 ------------------------------------------------------------------
LOG_LEVEL=INFO

# ============================================================================
# Phase 1A — OAuth 2.1 + PKCE 配置块
# ----------------------------------------------------------------------------
# QCN_BRIDGE_ISSUER       — OAuth issuer (MCP client discover 用)
#                            与 nginx server_name 对齐, 例如 https://cc.qicainiu.com
# QCN_BRIDGE_RESOURCE     — MCP resource URL (RFC 9728)
#                            通常 = ISSUER + "/mcp"
# QCN_BRIDGE_DB_PATH      — SQLite 文件位置 (oauth_clients/codes/tokens/bindings 4 表)
#                            MVP 用本地文件, 生产换 PostgreSQL
# QCN_BRIDGE_JWT_KEY_PATH — MCP access_token 签名 RSA 私钥
#                            首次部署跑 scripts/gen_jwt_key.py 生成
# QCN_BRIDGE_ACCESS_TTL   — access_token 有效期 (秒), 默认 3600 (1 小时)
# QCN_BRIDGE_REFRESH_TTL  — refresh_token 有效期 (秒), 默认 2592000 (30 天)
# ============================================================================
QCN_BRIDGE_ISSUER=https://cc.qicainiu.com
QCN_BRIDGE_RESOURCE=https://cc.qicainiu.com/mcp
QCN_BRIDGE_DB_PATH=~/.qcn-mcp-bridge/db.sqlite3
QCN_BRIDGE_JWT_KEY_PATH=~/.qcn-mcp-bridge/jwt-signing.pem
QCN_BRIDGE_ACCESS_TTL=3600
QCN_BRIDGE_REFRESH_TTL=2592000

# ============================================================================
# Phase 2B1 — 业务参数 (按接入清单 §6.3, 用户已确认 dev 值)
# ----------------------------------------------------------------------------
# QCN_DEV_SESSION_TTL_SECONDS  — 业务凭证有效期 (默认 3600 秒 = 60min, §7.1)
# QCN_DEV_KICK_CONCURRENT      — 并发登录是否踢下线 (默认 true, §7.3)
# QCN_DEV_RATE_LIMIT_PER_MINUTE — 接口调用每分钟限额 (0=无限, 默认 0, §7.4)
# ============================================================================
QCN_DEV_SESSION_TTL_SECONDS=3600
QCN_DEV_KICK_CONCURRENT=true
QCN_DEV_RATE_LIMIT_PER_MINUTE=0

# ============================================================================
# Phase 2B2 — Dev backdoor (本地 / CI 测试用)
# ----------------------------------------------------------------------------
# QCN_BRIDGE_DEV_LOGIN=true 时:
#   - POST /oauth/send-code 不真打 SMS, 把 6 位验证码直接回写到响应 JSON
#   - POST /oauth/login-form 在进程内 DEV_PENDING_CODES 校验 (one-time use)
#   - login user_id 固定 99999 (与生产 5 位 user_id 区分的哨兵值)
# 生产环境严禁设为 true. 默认 false.
# ============================================================================
QCN_BRIDGE_DEV_LOGIN=false